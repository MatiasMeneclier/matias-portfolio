    "model:generate": "node scripts/generate-laptop.mjs",
    "format": "node node_modules/prettier/bin/prettier.cjs --write app components hooks lib services store types scripts tests *.ts *.mjs *.json README.md docs",
    "test:browser": "node tests/browser.mjs",
