NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Demo is a separate browser-local sandbox, never a production authentication bypass.
ENABLE_ADMIN_DEMO=false

# Server-only contact notifications. Set these on the hosting server too.
RESEND_API_KEY=
# Sender from a domain verified in Resend, e.g. Portfolio <contact@your-domain.com>.
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=matimeneclier@gmail.com
